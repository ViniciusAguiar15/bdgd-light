{
  "name": "bdgd-light",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y gdal-bin && pip install -e '.[dev,twin,agent]'",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "GitHub.copilot", "GitHub.copilot-chat"]
    }
  }
}
